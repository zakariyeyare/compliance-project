# Email server configuration
EMAIL_SERVER_PORT=4000
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_username
EMAIL_PASS=your_password
EMAIL_FROM="Compliance App <noreply@example.com>"

# Optional: specify comma-separated origins for CORS (leave blank for default)
EMAIL_ALLOWED_ORIGINS=http://localhost:5173

# Frontend override (optional). Defaults to /api when omitted.
VITE_EMAIL_API_BASE=/api
