<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_User" name="USER" processRef="Process_User" />
    <bpmn:participant id="Participant_WebApp" name="WEBAPP" processRef="Process_WebApp" />
    <bpmn:participant id="Participant_Supabase" name="SUPABASE" processRef="Process_Supabase" />
    
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_User_Submit" targetRef="Task_WebApp_Receive" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_WebApp_Send" targetRef="Task_Supabase_Validate" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_Supabase_Return" targetRef="Gateway_WebApp_Success" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_WebApp_Load" targetRef="Task_User_Open" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_User" name="USER Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User">
      <bpmn:lane id="Lane_User" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_User_Open" name="Open Web App">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_User_Enter" name="Enter Email + Password">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_User_Submit" name="Submit Credentials">
      <bpmn:incoming>Flow_U3</bpmn:incoming>
      <bpmn:outgoing>Flow_U4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Policy Saved">
      <bpmn:incoming>Flow_U4</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_1" targetRef="Task_User_Open" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_User_Open" targetRef="Task_User_Enter" />
    <bpmn:sequenceFlow id="Flow_U3" sourceRef="Task_User_Enter" targetRef="Task_User_Submit" />
    <bpmn:sequenceFlow id="Flow_U4" sourceRef="Task_User_Submit" targetRef="EndEvent_1" />
  </bpmn:process>
  
  <bpmn:process id="Process_WebApp" name="WEBAPP Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WebApp">
      <bpmn:lane id="Lane_WebApp" name="WebApp Logic">
        <bpmn:flowNodeRef>Task_WebApp_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WebApp_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WebApp_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WebApp_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WebApp_Load</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:task id="Task_WebApp_Receive" name="Receive Credentials">
      <bpmn:outgoing>Flow_W1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WebApp_Send" name="Send to Supabase">
      <bpmn:incoming>Flow_W1</bpmn:incoming>
      <bpmn:outgoing>Flow_W2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WebApp_Success" name="Login Successful?">
      <bpmn:incoming>Flow_W2</bpmn:incoming>
      <bpmn:outgoing>Flow_W3_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_W3_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WebApp_Error" name="Show Error Message">
      <bpmn:incoming>Flow_W3_No</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_WebApp_Load" name="Load GDPR Structure + Options">
      <bpmn:incoming>Flow_W3_Yes</bpmn:incoming>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_W1" sourceRef="Task_WebApp_Receive" targetRef="Task_WebApp_Send" />
    <bpmn:sequenceFlow id="Flow_W2" sourceRef="Task_WebApp_Send" targetRef="Gateway_WebApp_Success" />
    <bpmn:sequenceFlow id="Flow_W3_Yes" name="Yes" sourceRef="Gateway_WebApp_Success" targetRef="Task_WebApp_Load" />
    <bpmn:sequenceFlow id="Flow_W3_No" name="No" sourceRef="Gateway_WebApp_Success" targetRef="Task_WebApp_Error" />
  </bpmn:process>
  
  <bpmn:process id="Process_Supabase" name="SUPABASE Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Supabase">
      <bpmn:lane id="Lane_Supabase" name="Database Operations">
        <bpmn:flowNodeRef>Task_Supabase_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supabase_Return</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:task id="Task_Supabase_Validate" name="Validate Credentials">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Supabase_Return" name="Return Auth Result">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_Supabase_Validate" targetRef="Task_Supabase_Return" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AuthenticationFlow">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="145" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="545" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="65" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="650" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="800" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="950" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1102" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1078" y="145" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="650" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="802" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="788" y="265" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="120" />
        <di:waypoint x="545" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_Yes_di" bpmnElement="Flow_4_Yes">
        <di:waypoint x="595" y="120" />
        <di:waypoint x="650" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="614" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_No_di" bpmnElement="Flow_4_No">
        <di:waypoint x="570" y="145" />
        <di:waypoint x="570" y="240" />
        <di:waypoint x="650" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="190" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="750" y="120" />
        <di:waypoint x="800" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="900" y="120" />
        <di:waypoint x="950" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1050" y="120" />
        <di:waypoint x="1102" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="750" y="240" />
        <di:waypoint x="802" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
